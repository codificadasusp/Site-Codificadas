<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-marca">
        <a href="/" class="footer-logo">
          <img src="/assets/img/logo/logo-white.png" alt="CodificADAs USP" loading="lazy" sizes="340px" eleventy:widths="340,510" eleventy:formats="webp,png">
        </a>
        <p class="footer-tagline">Inserindo meninas no mundo da programação.</p>
        <p class="footer-instituicao">Projeto de extensão do IME &mdash; Universidade de São Paulo.</p>
      </div>

      <nav class="footer-col" aria-label="Menu do rodapé">
        <h2 class="footer-col-titulo">Navegar</h2>
        <ul>
          {# o Blog já faz parte do menu principal, não precisa ser repetido aqui #}
          {% for item in nav %}
          <li><a href="{{ item.url }}">{{ item.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>

      <div class="footer-col">
        <h2 class="footer-col-titulo">Fale com a gente</h2>
        <ul>
          <li><a href="mailto:codificadas@usp.br">codificadas@usp.br</a></li>
          <li><a href="/o-projeto/#contato">Nossos endereços</a></li>
        </ul>
        <div class="social-links footer-social">
          <a href="https://www.instagram.com/codificadasusp/" aria-label="Instagram do CodificADAs" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
          </a>
          <a href="https://www.facebook.com/codificADAsUSP/" aria-label="Facebook do CodificADAs" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.5-3h-3V8.5c0-.9.3-1.5 1.6-1.5H16.5V4.2C16.2 4.1 15.2 4 14 4c-2.4 0-4 1.5-4 4.2V10.5H7.5v3H10V21h3.5z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {{ ano }} CodificADAs USP</span>
      <a href="#top" class="back-to-top">Voltar para o topo &uarr;</a>
    </div>
  </div>
</footer>
